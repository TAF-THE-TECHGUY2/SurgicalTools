# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Backend (Laravel)
/backend/vendor/
/backend/node_modules/
/backend/.env
/backend/.env.backup
/backend/storage/*.key
/backend/storage/framework/cache/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/storage/logs/*
/backend/database/database.sqlite
/backend/.phpunit.cache
/backend/public/storage

# Frontend (React/Vite)
/frontend/node_modules/
/frontend/dist/
/frontend/dev-dist/
/frontend/*.local

# Deployment secrets. deploy.sh generates the repo-root .env ON THE INSTANCE
# with APP_KEY and DB_PASSWORD in it — only /backend/.env was ignored before,
# so a `git add -A` on a deployed box would have committed live credentials.
/.env
/.env.*
!/.env.example

# Database dumps taken during a deploy
backup-*.sql
*.dump

# Docker
*.env.docker

# Claude Code session artifacts
.claude/
